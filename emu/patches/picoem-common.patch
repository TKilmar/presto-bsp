     /// JMP X-- with X=0 falls through without decrementing. Datasheet
     /// §3.4.4: the condition is `X != 0`; a zero X must neither jump
     /// nor wrap around to 0xFFFFFFFF.
+    /// Two RGB565 pixels per FIFO word, bit-reversed onto 16 pins:
+    /// `out isr, 16` / `mov pins, ::osr` / `out null, 16` / `in null, 16` / `mov pins, ::isr`
+    /// with both shift directions left. The first pixel (low half) must appear first.
+    #[test]
+    fn two_pixels_per_word_bit_reversed() {
+        let mut sm = StateMachine::new();
+        sm.enabled = true;
+        sm.shiftctrl = 1 << 17; // autopull, thresholds 32, shift left
+        sm.pinctrl = (16 << 20) | 1; // OUT_BASE 1, OUT_COUNT 16
+        let mut instr_mem = [0u16; 32];
+        instr_mem[..5].copy_from_slice(&[0x60d0, 0xa117, 0x6070, 0x4070, 0xa116]);
+        sm.tx_fifo.push(0x1111_ffff);
+        let (mut irq, mut pins, mut dirs) = (0u8, 0u32, 0u32);
+        let mut seen = std::vec::Vec::new();
+        for _ in 0..7 {
+            sm.execute_cycle(&instr_mem, &mut irq, 0, &mut pins, &mut dirs);
+            seen.push(((pins >> 1) & 0xffff) as u16);
+        }
+        let px: std::vec::Vec<u16> = seen.iter().map(|v| v.reverse_bits()).collect();
+        assert_eq!(px[1], 0xffff, "{px:x?}");
+        assert_eq!(px[6], 0x1111, "{px:x?}");
+    }
+
+    /// A WAIT that stalled on an IRQ flag must complete once another SM sets the flag (and
+    /// consume it), rather than having the flag cleared by the stall check and stalling again.
+    #[test]
+    fn stalled_wait_irq_completes_when_flag_set() {
+        let mut sm = StateMachine::new();
+        sm.enabled = true;
+        let mut instr_mem = [0u16; 32];
+        instr_mem[0] = 0x20c4; // wait 1 irq 4
+        let (mut irq, mut pins, mut dirs) = (0u8, 0u32, 0u32);
+        sm.execute_cycle(&instr_mem, &mut irq, 0, &mut pins, &mut dirs);
+        assert!(sm.stalled);
+        irq |= 1 << 4; // another state machine runs `irq set 4`
+        sm.execute_cycle(&instr_mem, &mut irq, 0, &mut pins, &mut dirs);
+        assert!(!sm.stalled, "WAIT must complete");
+        assert_eq!(sm.pc, 1);
+        assert_eq!(irq, 0, "WAIT consumes the flag");
+    }
+
